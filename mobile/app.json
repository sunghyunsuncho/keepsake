{
  "expo": {
    "name": "Keepsake",
    "slug": "keepsake",
    "owner": "atelier-labs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "keepsake",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.atelierlabs.keepsake",
      "appleTeamId": "3BQ7Y687R9",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:keepsake.atelierlabs.co.kr"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.atelierlabs.keepsake",
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "keepsake.atelierlabs.co.kr",
              "path": "/join"
            },
            {
              "scheme": "https",
              "host": "keepsake.atelierlabs.co.kr",
              "path": "/en/join"
            },
            {
              "scheme": "https",
              "host": "keepsake.atelierlabs.co.kr",
              "path": "/ja/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "atelier-labs",
          "project": "keepsake-mobile"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#CD5837"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "남기고 싶은 사진과 동영상을 고르고, 원할 때 남기지 않은 것을 정리하고, Cloud에 보관한 사진과 동영상을 다시 저장하기 위해 사진 보관함에 접근합니다.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": true,
          "preventAutomaticLimitedAccessAlert": true,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          },
          "android": {
            "extraProguardRules": "-keep class com.google.android.gms.internal.consent_sdk.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "newArchEnabled": true,
    "extra": {
      "router": {},
      "eas": {
        "projectId": "12930956-1eea-4867-a793-d68ee6cf87e8"
      }
    }
  }
}
