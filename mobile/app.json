{
  "expo": {
    "name": "Keepsake",
    "slug": "keepsake",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "keepsake",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.atelierlabs.keepsake",
      "appleTeamId": "3BQ7Y687R9",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F1EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.atelierlabs.keepsake",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#B5651D"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "photosPermission": "남기고 싶은 사진을 고르고, 원할 때 남기지 않은 사진을 정리하고, Cloud에 보관한 사진을 다시 저장하기 위해 사진 보관함에 접근합니다.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": true,
          "preventAutomaticLimitedAccessAlert": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "newArchEnabled": true,
    "extra": {
      "router": {},
      "eas": {
        "projectId": "12930956-1eea-4867-a793-d68ee6cf87e8"
      }
    }
  }
}
