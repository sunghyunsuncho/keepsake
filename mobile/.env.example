# iOS 시뮬레이터는 localhost. 실기기는 ../set-ip.sh가 Mac의 LAN IP로 바꿔 준다 (./set-ip.sh --local로 복귀).
EXPO_PUBLIC_API_URL=http://localhost:18020

# Cloud (Phase 2). 비워 두면 해당 기능의 버튼이 숨겨진다.
# RevenueCat 공개 SDK 키 (Project settings → API keys, appl_... / goog_...)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Google 로그인: 웹 클라이언트 ID(토큰의 aud, 서버 GOOGLE_CLIENT_ID와 같게)와 iOS 클라이언트 ID.
# iOS 클라이언트 ID가 바뀌면 네이티브 설정(URL scheme)이 바뀌므로 다시 빌드한다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android 지도 화면용 Google Maps SDK 키 (Android 앱 패키지명·서명으로 제한)
GOOGLE_MAPS_API_KEY=

# AdMob (src/lib/ads.ts). 앱 ID는 네이티브 설정이라 바꾸면 다시 빌드한다. 비우면 Google 예시 앱 ID로 빌드되고,
# production EAS 빌드는 실제 앱 ID가 없으면 실패한다. 개발·preview 빌드는 단위 ID와 관계없이 테스트 광고를 띄운다
# (실제 광고는 EXPO_PUBLIC_APP_ENV=production인 스토어 빌드에서만).
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
# 배너 광고 단위 ID. 출시 빌드에서 비우면 광고를 띄우지 않는다.
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=

# Sentry keepsake-mobile 프로젝트의 DSN. 비워 두면 보내지 않는다.
EXPO_PUBLIC_SENTRY_DSN=
