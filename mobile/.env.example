# 실기기에서 테스트할 때는 Mac의 LAN IP로 바꾼다 (예: http://192.168.0.10:8010)
# 확인: ipconfig getifaddr en0
EXPO_PUBLIC_API_URL=http://localhost:8010

# Cloud (Phase 2). 비워 두면 해당 기능의 버튼이 숨겨진다.
# RevenueCat 공개 SDK 키 (Project settings → API keys, appl_... / goog_...)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Google 로그인: 웹 클라이언트 ID(토큰의 aud, 서버 GOOGLE_CLIENT_ID와 같게)와 iOS 클라이언트 ID.
# iOS 클라이언트 ID가 바뀌면 네이티브 설정(URL scheme)이 바뀌므로 다시 빌드한다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
