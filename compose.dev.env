# Local host-port allocation. Keep this file committed so the local projects
# (vernissage, keepsake, atelierlabs) can run together without port clashes.
#
# API_PORT: 호스트에서 uv로 띄우는 FastAPI (./start.sh, make api)
# METRO_PORT: Expo 개발 서버 (make mobile, npm start)
# REDIS_PORT: keepsake에 배정된 예약 포트. 아직 Redis를 쓰지 않는다.
# S3_PORT / S3_CONSOLE_PORT: 로컬 R2 대용(RustFS). 배정표에 없는 keepsake 전용 포트.
API_PORT=18020
POSTGRES_PORT=15434
REDIS_PORT=16381
METRO_PORT=18082
S3_PORT=9010
S3_CONSOLE_PORT=9011
