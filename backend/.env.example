ENV=local
DATABASE_URL=postgresql+psycopg://keepsake:keepsake@localhost:5433/keepsake

R2_ENDPOINT_URL=http://localhost:9010
R2_ACCESS_KEY_ID=keepsake
R2_SECRET_ACCESS_KEY=keepsake-secret
R2_BUCKET=keepsake-local

# Cloud (Phase 2). 로컬 기본값으로도 서버는 뜨지만, 로그인·결제를 시험하려면 채운다.
# JWT_SECRET는 최소 32바이트의 무작위 값으로 바꾼다 (production에서 기본값이면 시작하지 않는다).
JWT_SECRET=replace-with-a-long-random-secret
# ID 토큰 aud. Apple은 번들 ID, Google은 웹 클라이언트 ID (여러 개면 쉼표로 구분)
APPLE_CLIENT_ID=com.atelierlabs.keepsake
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# false면 결제 없이 로그인만으로 Cloud를 쓴다 (결제 연결 전 개발용). ENV=production에서는 true 필수
CLOUD_BILLING_ENABLED=false
# RevenueCat: webhook Authorization 값, 비밀 API 키(sk_..., 구독 상태 재조회용), entitlement 식별자
# ENV=production에서는 webhook 값과 API 키가 필수다 (없으면 서버가 시작하지 않는다).
REVENUECAT_WEBHOOK_SECRET=replace-with-revenuecat-webhook-secret
REVENUECAT_API_KEY=
REVENUECAT_ENTITLEMENT_ID=cloud
# Expo 푸시 '보안 푸시'를 켰을 때만
EXPO_ACCESS_TOKEN=
# Sentry keepsake-backend 프로젝트의 DSN. 비워 두면 보내지 않는다.
SENTRY_DSN=
