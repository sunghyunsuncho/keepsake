{
  "openapi": "3.1.0",
  "info": {
    "title": "Keepsake API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "서버 프로세스가 살아 있는지 확인한다.",
        "operationId": "health_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "description": "DB까지 연결되어 요청을 처리할 준비가 되었는지 확인한다.",
        "operationId": "health_ready",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/sign-in": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign In",
        "operationId": "auth_sign_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/account": {
      "get": {
        "tags": [
          "account"
        ],
        "summary": "Get Account",
        "operationId": "account_get_account",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "delete": {
        "tags": [
          "account"
        ],
        "summary": "Remove Account",
        "description": "서버 데이터와 R2 객체를 바로 지운다. 앱은 기기 사진의 기록을 Local에 남기고 돌아간다.\n\n스토어 구독은 서버가 해지할 수 없으므로 앱이 해지 방법을 안내한다.",
        "operationId": "account_remove_account",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/account/refresh-subscription": {
      "post": {
        "tags": [
          "account"
        ],
        "summary": "Refresh Subscription",
        "description": "구매·복원 직후 앱이 부른다. webhook보다 먼저 맞추려고 RevenueCat을 직접 조회한다.",
        "operationId": "account_refresh_subscription",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/account/devices": {
      "put": {
        "tags": [
          "account"
        ],
        "summary": "Register Device",
        "operationId": "account_register_device",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/sync/push": {
      "post": {
        "tags": [
          "sync"
        ],
        "summary": "Push",
        "operationId": "sync_push",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/sync/pull": {
      "get": {
        "tags": [
          "sync"
        ],
        "summary": "Pull",
        "operationId": "sync_pull",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PullResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sync/device-links": {
      "put": {
        "tags": [
          "sync"
        ],
        "summary": "Put Device Links",
        "operationId": "sync_put_device_links",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutDeviceLinksRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "sync"
        ],
        "summary": "Get Device Links",
        "description": "요청한 기기의 연결만 돌려준다. moment_id 순으로 나눠 받는다.",
        "operationId": "sync_get_device_links",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "device_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "title": "Device Id"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 36,
              "default": "",
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceLinksResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/uploads": {
      "post": {
        "tags": [
          "uploads"
        ],
        "summary": "Create Upload",
        "operationId": "uploads_create_upload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/uploads/{upload_id}/complete": {
      "post": {
        "tags": [
          "uploads"
        ],
        "summary": "Complete Upload",
        "operationId": "uploads_complete_upload",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "upload_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Upload Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/moments/{moment_id}/photo": {
      "get": {
        "tags": [
          "uploads"
        ],
        "summary": "Download Photo",
        "operationId": "uploads_download_photo",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "moment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Moment Id"
            }
          },
          {
            "name": "variant",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "display",
                "original"
              ],
              "type": "string",
              "title": "Variant"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/photos/delete": {
      "post": {
        "tags": [
          "uploads"
        ],
        "summary": "Delete Photos",
        "description": "기록은 남기고 사진만 지운다 (안전 앨범에서 빼거나, 앨범을 효율 보관으로 바꿨을 때).\n\n지우는 것은 구독 상태와 관계없이 허용한다. 사용량은 바로 돌려주고, R2는 정리 작업이 지운다.\n없는 사진은 건너뛴다 (다른 기기가 먼저 지웠거나 응답을 못 받고 다시 보낸 경우).",
        "operationId": "uploads_delete_photos",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeletePhotosRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/billing/revenuecat": {
      "post": {
        "tags": [
          "billing"
        ],
        "summary": "Revenuecat Webhook",
        "operationId": "billing_revenuecat_webhook",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "data_generation": {
            "type": "integer",
            "title": "Data Generation"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "subscription": {
            "$ref": "#/components/schemas/SubscriptionState"
          },
          "usage": {
            "$ref": "#/components/schemas/StorageUsage"
          },
          "has_records": {
            "type": "boolean",
            "title": "Has Records"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "data_generation",
          "email",
          "subscription",
          "usage",
          "has_records"
        ],
        "title": "AccountResponse"
      },
      "CreateUploadRequest": {
        "properties": {
          "moment_id": {
            "type": "string",
            "maxLength": 36,
            "title": "Moment Id"
          },
          "variant": {
            "type": "string",
            "enum": [
              "display",
              "original"
            ],
            "title": "Variant"
          },
          "size": {
            "type": "integer",
            "maximum": 1073741824.0,
            "exclusiveMinimum": 0.0,
            "title": "Size"
          },
          "content_type": {
            "type": "string",
            "pattern": "^image/[a-zA-Z0-9.+-]+$",
            "title": "Content Type"
          },
          "md5": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{32}$",
            "title": "Md5"
          }
        },
        "type": "object",
        "required": [
          "moment_id",
          "variant",
          "size",
          "content_type",
          "md5"
        ],
        "title": "CreateUploadRequest"
      },
      "DeletePhotosRequest": {
        "properties": {
          "photos": {
            "items": {
              "$ref": "#/components/schemas/PhotoRef"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Photos"
          }
        },
        "type": "object",
        "required": [
          "photos"
        ],
        "title": "DeletePhotosRequest"
      },
      "DeviceLinkRow": {
        "properties": {
          "moment_id": {
            "type": "string",
            "maxLength": 36,
            "title": "Moment Id"
          },
          "asset_id": {
            "type": "string",
            "maxLength": 255,
            "title": "Asset Id"
          }
        },
        "type": "object",
        "required": [
          "moment_id",
          "asset_id"
        ],
        "title": "DeviceLinkRow"
      },
      "DeviceLinksResponse": {
        "properties": {
          "links": {
            "items": {
              "$ref": "#/components/schemas/DeviceLinkRow"
            },
            "type": "array",
            "title": "Links"
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More"
          }
        },
        "type": "object",
        "required": [
          "links",
          "has_more"
        ],
        "title": "DeviceLinksResponse"
      },
      "DeviceRequest": {
        "properties": {
          "expo_push_token": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^Expo(nent)?PushToken\\[.+\\]$",
            "title": "Expo Push Token"
          },
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android"
            ],
            "title": "Platform"
          }
        },
        "type": "object",
        "required": [
          "expo_push_token",
          "platform"
        ],
        "title": "DeviceRequest"
      },
      "DownloadResponse": {
        "properties": {
          "download_url": {
            "type": "string",
            "title": "Download Url"
          },
          "content_type": {
            "type": "string",
            "title": "Content Type"
          },
          "extension": {
            "type": "string",
            "title": "Extension"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "download_url",
          "content_type",
          "extension",
          "size",
          "expires_at"
        ],
        "title": "DownloadResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "PhotoRef": {
        "properties": {
          "moment_id": {
            "type": "string",
            "maxLength": 36,
            "title": "Moment Id"
          },
          "variant": {
            "type": "string",
            "enum": [
              "display",
              "original"
            ],
            "title": "Variant"
          }
        },
        "type": "object",
        "required": [
          "moment_id",
          "variant"
        ],
        "title": "PhotoRef"
      },
      "PullResponse": {
        "properties": {
          "moments": {
            "items": {
              "$ref": "#/components/schemas/SyncMoment"
            },
            "type": "array",
            "title": "Moments"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/SyncRecordRow"
            },
            "type": "array",
            "title": "Records"
          },
          "cursor": {
            "type": "integer",
            "title": "Cursor"
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More"
          }
        },
        "type": "object",
        "required": [
          "moments",
          "records",
          "cursor",
          "has_more"
        ],
        "title": "PullResponse"
      },
      "PushRequest": {
        "properties": {
          "moments": {
            "items": {
              "$ref": "#/components/schemas/SyncMoment"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Moments"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/SyncRecordRow"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Records"
          }
        },
        "type": "object",
        "title": "PushRequest"
      },
      "PushResponse": {
        "properties": {
          "stale_moment_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Stale Moment Ids"
          },
          "stale_record_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Stale Record Ids"
          }
        },
        "type": "object",
        "required": [
          "stale_moment_ids",
          "stale_record_ids"
        ],
        "title": "PushResponse"
      },
      "PutDeviceLinksRequest": {
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Device Id"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/DeviceLinkRow"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Links"
          }
        },
        "type": "object",
        "required": [
          "device_id",
          "links"
        ],
        "title": "PutDeviceLinksRequest"
      },
      "SessionResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type",
            "default": "bearer"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "user_id"
        ],
        "title": "SessionResponse"
      },
      "SignInRequest": {
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "apple",
              "google"
            ],
            "title": "Provider"
          },
          "identity_token": {
            "type": "string",
            "maxLength": 8192,
            "title": "Identity Token"
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 320
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "identity_token"
        ],
        "title": "SignInRequest"
      },
      "StorageUsage": {
        "properties": {
          "bytes_total": {
            "type": "integer",
            "title": "Bytes Total"
          },
          "object_count": {
            "type": "integer",
            "title": "Object Count"
          },
          "max_bytes": {
            "type": "integer",
            "title": "Max Bytes"
          }
        },
        "type": "object",
